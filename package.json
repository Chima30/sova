{
  "name": "sova",
  "productName": "SOVA",
  "version": "0.5.0",
  "description": "SOVA: a personal focus and recovery workstation. Stay in focus. Stay in tune.",
  "author": "John Madubuike Chimaobi <johnchimz15@gmail.com>",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/app.js --bundle --outfile=dist/renderer.js --platform=browser --format=iife --log-level=warning",
    "build:preload": "esbuild src/preload/preload.js --bundle --outfile=dist/preload.js --platform=node --external:electron --format=cjs --log-level=warning",
    "build": "npm run build:renderer && npm run build:preload",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "smoke": "npm run build && electron test/smoke/electron-smoke.js",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "docs:machines": "node scripts/gen-state-docs.js",
    "smoke:checkin": "npm run build && electron test/smoke/checkin-smoke.js",
    "demo": "npm run build && node scripts/start-demo.js"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.6.0",
    "esbuild": "^0.25.0",
    "lucide-static": "^1.70.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "app.sova.desktop",
    "productName": "SOVA",
    "files": [
      "src/main/**",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/widget.html",
      "src/renderer/widget.js",
      "src/renderer/fonts/**",
      "src/preload/widget-preload.js",
      "shared/**",
      "dist/**",
      "node_modules/**",
      "!node_modules/@smartspectra/node-sdk-*/**",
      "!node_modules/@smartspectra/node-sdk/scripts/**",
      "!node_modules/@smartspectra/node-sdk/test/**",
      "!node_modules/@smartspectra/node-sdk/samples/**",
      "!node_modules/@smartspectra/node-sdk/prebuilds/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "SOVA uses the camera during focus sessions to estimate breathing, pulse and HRV on this device. No video is saved.",
        "NSMicrophoneUsageDescription": "SOVA uses the microphone only if you turn on breath sound analysis, during a breathing reset, to time your breaths. Audio is never recorded or saved."
      },
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-darwin-${arch}/",
          "to": "smartspectra"
        }
      ],
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "SOVA-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "SOVA-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOVA",
      "uninstallDisplayName": "SOVA",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/",
          "to": "smartspectra"
        }
      ],
      "icon": "build/icon.png"
    },
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "publish": null
  }
}
